# Address the dashboard listens on. Use the server's LAN IP, or 0.0.0.0 to listen
# on every interface (for example LAN and Tailscale); keep the port off the internet.
LAN_IP=192.168.1.100
SSH_TARGET=youruser@192.168.1.100
# SSH port of the server, if it is not 22.
SSH_PORT=22
SCRIPT_ROOT=/home/youruser
# Comma-separated folders available in script and file pickers.
ALLOWED_PATHS=/home/youruser/scripts,/mnt/media
# Comma-separated mount paths shown as storage cards on the dashboard.
MONITORED_PATHS=/mnt/storage
REMOTE_LOGS=/home/youruser/.local/state/media-dashboard
# Days of CPU/RAM/temperature/disk samples retained in DATA_DIR (1-365).
METRICS_RETENTION_DAYS=30
# Reuse one SSH connection for consecutive commands. Set to false if /tmp is not writable.
SSH_MULTIPLEX=true
# Image tag to run: latest, or a released version such as 0.3.0.
VERSION=latest
# Only with the optional HTTPS profile (see INSTALL.md): the name or IP in the
# certificate, and Secure cookies.
#HTTPS_HOST=192.168.1.100
#COOKIE_SECURE=true
