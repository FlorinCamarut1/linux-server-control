LAN_IP=192.168.1.100
LAN_CIDR=192.168.1.0/24
SSH_TARGET=youruser@192.168.1.100
SCRIPT_ROOT=/home/youruser
# Comma-separated folders available in script and file pickers.
ALLOWED_PATHS=/home/youruser/scripts,/home/youruser/apps,/mnt/media,/srv/backups
REMOTE_LOGS=/home/youruser/.local/state/media-dashboard
DASHBOARD_USER=admin

# Optional Tailscale access. Also set COMPOSE_FILE as shown below.
# TAILSCALE_IP=100.x.y.z
# TAILSCALE_HOST=server-name.tailnet-name.ts.net
# COMPOSE_FILE=compose.yaml:compose.tailscale.yaml
